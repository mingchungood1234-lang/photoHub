# Server Port (exposed on host and inside container)
PORT=3000

# Protocol: 'http' (default, for LAN/VPN/reverse-proxy) or 'https' (requires SSL_CERT_PATH & SSL_KEY_PATH)
PROTOCOL=http
# SSL_CERT_PATH=/app/certs/cert.pem
# SSL_KEY_PATH=/app/certs/key.pem

# Host path on Ubuntu VPS mounted into the Docker container (used by docker-compose.yml)
HOST_STORAGE_DIR=/home/ubuntu/gdrive/photoHUB

# User/Group ID on Ubuntu VPS (1000:1000 is the default 'ubuntu' user)
PUID=1000
PGID=1000

# Directory where uploaded photos are organized when running directly without Docker
STORAGE_DIR=/home/ubuntu/gdrive/photoHUB

# Directory where the SHA-256 hash index is stored when running directly without Docker
DATA_DIR=./data

# Multi-User API Keys -> Folder mapping (format: apiKey1:folderName1,apiKey2:folderName2)
# Example: mingchun:mingchun,family123:family,alice_key:alice
# Photos for 'mingchun' will be saved in /home/ubuntu/gdrive/photoHUB/mingchun/YYYY/YYYY-MM-DD/
USER_KEYS=mingchun:mingchun,user2_key:user2

# Optional single fallback API key (stores directly in root STORAGE_DIR if used)
API_KEY=

# Maximum upload size per photo/video in MB
MAX_FILE_SIZE_MB=50000

# Scan existing files in STORAGE_DIR on server startup (set to false if /home/ubuntu/gdrive is a slow remote mount)
SCAN_STORAGE_ON_STARTUP=true

# Public HTTPS URL of this server (recommended behind reverse proxy for Google OAuth callbacks)
# PUBLIC_URL=https://photohub.yourdomain.com

# Require login / key even if USER_KEYS & API_KEY are empty (set true on storage worker nodes)
REQUIRE_AUTH=false

# Shared HMAC secret for stateless Bearer session tokens across Gateway and Storage Nodes
# AUTH_SESSION_SECRET=replace-with-long-random-64-char-hex-secret
# AUTH_SESSION_TTL_SECONDS=2592000

# Google OAuth 2.0 credentials (stays ONLY on backend server - never compiled into iOS app)
# Create a Web Application OAuth client in Google Cloud Console with redirect URI:
#   <PUBLIC_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ALLOWED_GOOGLE_DOMAINS=
# ALLOWED_GOOGLE_EMAILS=

# Multi-Server Instance Routing (configured on the Central Auth Gateway)
# STORAGE_NODES=node1=https://node1.yourdomain.com,node2=https://node2.yourdomain.com
# USER_NODE_MAP=alice@gmail.com=node2

# Per-User Storage Limits in GB (0 = no fixed cap; shows server disk free/total space)
DEFAULT_QUOTA_GB=0
# USER_QUOTAS=alice@gmail.com:50,mingchun:100

# Optional S3 / MinIO pre-signed URL configuration (leave empty to use direct VPS storage)
# S3_ENDPOINT=https://minio.example.com
# S3_REGION=us-east-1
# S3_BUCKET=photohub
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
